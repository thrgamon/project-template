#!/bin/sh
# Generate stable, local-only Docker Compose settings for this Git worktree.
#
# The values are derived from the absolute worktree path and persisted so every
# `just` command for this worktree talks to the same containers and database.
set -eu

root_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
env_file="$root_dir/.worktree.env"

if [ -f "$env_file" ]; then
  exit 0
fi

# Keep the Compose name readable, while the longer digest avoids collisions
# between similarly named worktrees. cksum is available on macOS and Linux.
checksum=$(printf '%s' "$root_dir" | cksum | awk '{print $1}')
worktree_id=$(printf '%08x' "$checksum" | cut -c1-8)

# Each worktree receives a contiguous, deterministic port block in the
# unprivileged range. Compose project names also isolate named volumes and
# containers, so its database and any future fixture data are never shared.
port_offset=$((checksum % 3500))
port_base=$((20000 + port_offset * 10))

# Avoid an active process (including another worktree) when this environment is
# first created. The chosen block is then persisted, so subsequent commands
# keep addressing the same local services.
ports_available() {
  candidate=$1
  port=$candidate
  while [ "$port" -le $((candidate + 9)) ]; do
    if nc -z 127.0.0.1 "$port" >/dev/null 2>&1; then
      return 1
    fi
    port=$((port + 1))
  done
  return 0
}

while ! ports_available "$port_base"; do
  port_offset=$(((port_offset + 1) % 3500))
  port_base=$((20000 + port_offset * 10))
done

umask 077
cat > "$env_file" <<EOF
# Generated by scripts/worktree-env. This file is intentionally gitignored.
COMPOSE_PROJECT_NAME=project-template-$worktree_id
POSTGRES_DB=project_template_$worktree_id
POSTGRES_PORT=$port_base
BACKEND_PORT=$((port_base + 1))
FRONTEND_PORT=$((port_base + 2))
ALLOY_GRPC_PORT=$((port_base + 3))
ALLOY_HTTP_PORT=$((port_base + 4))
ALLOY_UI_PORT=$((port_base + 5))
PROMETHEUS_PORT=$((port_base + 6))
LOKI_PORT=$((port_base + 7))
TEMPO_PORT=$((port_base + 8))
GRAFANA_PORT=$((port_base + 9))
EOF

echo "Created $env_file for worktree $worktree_id (frontend: $((port_base + 2)), backend: $((port_base + 1)))" >&2

{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"files": { "includes": ["**", "!**/node_modules", "!**/build", "!**/.svelte-kit"] },
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended", "correctness": { "noUnusedImports": "warn", "noUnusedVariables": "off" } }
	},
	"formatter": { "enabled": true, "indentStyle": "tab", "indentWidth": 2, "lineWidth": 120 },
	"javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } }
}

# Stage 1: Build static SvelteKit frontend
FROM node:22-alpine AS frontend-builder

WORKDIR /app/frontend

COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile

COPY frontend/ ./

RUN yarn run build

# Stage 2: Build Go backend
FROM golang:1.25-alpine AS backend-builder

WORKDIR /app

COPY go.mod go.sum ./
COPY vendor/ vendor/

# Install goose for migrations
# Keep in step with GOOSE_VERSION in the justfile.
ARG GOOSE_VERSION=v3.27.3
RUN go install github.com/pressly/goose/v3/cmd/goose@${GOOSE_VERSION}

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o server ./cmd/server

# Stage 3: Production runtime
FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy Go backend binary
COPY --from=backend-builder /app/server ./server

# Copy goose binary and migrations
COPY --from=backend-builder /go/bin/goose ./goose
COPY migrations/ ./migrations/

# Copy static SvelteKit output. Go serves this directory at the same origin as
# its /api routes, so production does not run a second web server.
COPY --from=frontend-builder /app/frontend/build ./frontend/build

# Copy app.json for Dokku predeploy hooks
COPY app.json ./

EXPOSE 5000

ENV STATIC_DIR=/app/frontend/build
CMD ["./server"]
